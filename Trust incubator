      </div>
      <div class="flex gap-3">
        <button onclick="waOrder(${p.id})" class="flex-1 bg-forest-600 hover:bg-forest-700 text-white font-bold py-3 rounded-xl transition">
          💬 WhatsApp অর্ডার
