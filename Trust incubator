  document.getElementById('modal-box').innerHTML = `
    <div class="bg-gradient-to-br from-forest-50 to-gold-50 p-8 text-center relative">
      <button onclick="closeModal()" class="absolute top-3 right-4 text-gray-400 hover:text-gray-600 text-3xl font-light leading-none">×</button>
      <span class="${p.bc} text-white text-xs font-bold px-3 py-1 rounded-full absolute top-3 left-3">${p.badge}</span>
      <div class="text-8xl">${p.emoji}</div>
    </div>
    <div class="p-6">
