function renderProducts(list) {
  const grid = document.getElementById('product-grid');
  const noRes = document.getElementById('no-results');
  if (!list.length) { grid.innerHTML=''; noRes.classList.remove('hidden'); return; }
  noRes.classList.add('hidden');
  grid.innerHTML = list.map(p => {
    const disc = p.old ? Math.round((1 - p.price / p.old) * 100) : 0;
    return `
    <div class="product-card bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm" onclick="openModal(${p.id})">
      <div class="bg-gradient-to-br from-forest-50 to-gold-50 p-6 text-center relative">
        <span class="${p.bc} text-white text-[11px] font-bold px-2 py-0.5 rounded-full absolute top-2 left-2">${p.badge}</span>
        ${disc ? `<span class="bg-red-500 text-white text-[11px] font-bold px-2 py-0.5 rounded-full absolute top-2 right-2">-${disc}%</span>` : ''}
        <div class="text-6xl">${p.emoji}</div>
      </div>
      <div class="p-4">
        <h3 class="font-bold text-gray-800 text-sm leading-tight mb-0.5">${p.name}</h3>
        <p class="text-gray-400 text-xs mb-3">${p.en}</p>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-forest-600 font-bold text-lg">৳${p.price.toLocaleString()}</span>
          ${p.old ? `<span class="text-gray-300 line-through text-sm">৳${p.old.toLocaleString()}</span>` : ''}
        </div>
        <div class="flex gap-2">
          <button onclick="event.stopPropagation();waOrder(${p.id})"
            class="flex-1 bg-forest-600 hover:bg-forest-700 text-white text-xs font-bold py-2 rounded-xl transition">
            🛒 অর্ডার
          </button>
          <button onclick="event.stopPropagation();openModal(${p.id})"
            class="px-3 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs font-bold py-2 rounded-xl transition">👁</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

function filterProducts(cat) {
  const list = cat === 'all' ? PRODUCTS : PRODUCTS.filter(p => p.cat === cat);
  renderProducts(list);
  // update filter button styles
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('bg-forest-600', b.dataset.cat === cat);
    b.classList.toggle('text-white', b.dataset.cat === cat);
    b.classList.toggle('bg-gray-100', b.dataset.cat !== cat);
    b.classList.toggle('text-gray-700', b.dataset.cat !== cat);
  });
}

function handleSearch(q) {
  const lower = q.toLowerCase();
  const res = PRODUCTS.filter(p => p.name.includes(q) || p.en.toLowerCase().includes(lower) || p.badge.includes(q));
  renderProducts(res);
}

